# MyProject stack — copy to .env and fill in real values

# Hostname for the MyWeb SPA (Traefik route)
MYPROJECT_DOMAIN=myproject.example.com

# MyAgent — JWT signing secret (required, min 32 bytes)
# Generate: openssl rand -hex 32
MYAGENT_JWT_SECRET=

# MyAgent — API key for protected endpoints (required for production)
# Generate: openssl rand -hex 32
# This same value is baked into the MyWeb build as VITE_API_KEY
MYAGENT_API_KEY=

# devTeam daemon admin API key
# Generate: openssl rand -hex 32
DEVTEAM_ADMIN_API_KEY=

# Ollama endpoint — homelab ollama on ween-arch (192.168.1.40)
OLLAMA_HOST=http://192.168.1.40:11434

# LLM model name (must be pulled in ollama before first use)
LLM_MODEL=qwen3:8b
