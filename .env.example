# Copy to `.env` next to docker-compose.yml. Compose loads it automatically.
# `.env` is gitignored — never commit real keys.

# ── Exposure ──────────────────────────────────────────────────────────
# Interface the published ports bind to. Loopback by default: this stack mounts
# the host docker socket into myagent, and MyAgent serves unauthenticated when
# the API key is empty, so exposing it on the LAN is a path to host root. That
# combination is why myagent was removed from the homelab deploy on 2026-07-06.
# Set 0.0.0.0 only for a deployment where you have set MYDEVTEAM_API_KEY and
# accepted the docker-socket mount.
BIND_HOST=127.0.0.1

# ── devTeam (required) ────────────────────────────────────────────────
# The daemon fails closed and exits at startup if this is empty, because its
# admin endpoints would otherwise be unprotected. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MYDEVTEAM_API_KEY=

# Comma-separated emails auto-promoted to admin on startup. Empty = nobody.
MYDEVTEAM_ADMIN_EMAILS=

# Extra CORS origins, comma-separated. localhost:5173 is always allowed.
# Set this to your real frontend origin when deploying behind a hostname.
MYDEVTEAM_ALLOWED_ORIGINS=

# ── MyAgent ───────────────────────────────────────────────────────────
# MyAgent reads MYDEVTEAM_API_KEY too (same key covers both services).
# WARNING: unlike devTeam, MyAgent starts anyway when it is empty and serves
# with NO authentication at all.

# Signs session JWTs. Leave empty and MyAgent invents a random one per process,
# so every restart invalidates all logins. Generate once, then keep it stable:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# CORS origins for the API, comma-separated. Code default is "*", which browsers
# reject because credentials are enabled — set the real frontend origin.
ALLOWED_ORIGINS=http://localhost:5173

# ── MyWeb build args ──────────────────────────────────────────────────
# Baked into the SPA bundle at BUILD time — changing these needs a rebuild
# (`docker compose build myweb`), not just a restart. The browser runs on the
# host, so these are host-reachable URLs, not compose service names.
VITE_API_BASE_URL=http://localhost:8000
VITE_DEVTEAM_API_URL=http://localhost:4223

# Leave empty in any deployment more public than your own machine: anything
# here is readable in the shipped JavaScript. Users can enter their key at
# runtime instead (stored in localStorage by the login page).
VITE_API_KEY=
VITE_DEVTEAM_API_KEY=
