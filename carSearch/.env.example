# carSearch configuration. Copy to `.env` and fill in what you have.
# All variables are prefixed CARSEARCH_.

# --- Server ---
CARSEARCH_PER_SITE_TIMEOUT=12
CARSEARCH_MAX_CONCURRENCY=8
CARSEARCH_USER_AGENT=carSearch/0.1 (+homelab)
# Comma-separated allowed CORS origins, or * for any.
CARSEARCH_CORS_ORIGINS=*

# --- Demo adapter ---
# Returns synthetic listings so the service works out of the box. Turn off in prod.
CARSEARCH_ENABLE_DEMO=true

# --- eBay Motors (Browse API) ---
# Create an app at https://developer.ebay.com/ to get these.
CARSEARCH_EBAY_CLIENT_ID=
CARSEARCH_EBAY_CLIENT_SECRET=
CARSEARCH_EBAY_MARKETPLACE=EBAY_US

# --- Craigslist (best-effort RSS) ---
# Craigslist has no API; results come from a region's RSS feed.
CARSEARCH_CRAIGSLIST_REGION=sfbay
